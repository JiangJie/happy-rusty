{
  "name": "happy-rusty",
  "description": "Rust's Option, Result, and sync primitives for JavaScript/TypeScript - Better error handling and null-safety patterns.",
  "author": "jiang115jie@gmail.com",
  "license": "MIT",
  "version": "1.10.1",
  "type": "module",
  "main": "dist/mod.cjs",
  "module": "dist/mod.mjs",
  "types": "dist/mod.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mod.d.mts",
        "default": "./dist/mod.mjs"
      },
      "require": {
        "types": "./dist/mod.d.cts",
        "default": "./dist/mod.cjs"
      },
      "default": "./dist/mod.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "pnpm exec vp check",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "pnpm exec vp lint",
    "fmt": "pnpm exec vp fmt",
    "test": "pnpm exec vp test run --coverage",
    "prebuild": "pnpm run check",
    "build": "pnpm exec vp pack",
    "verify:package": "pnpm exec attw --pack && pnpm exec publint --strict",
    "prepublishOnly": "pnpm run build && pnpm run verify:package",
    "docs": "pnpm exec typedoc",
    "examples": "node examples/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiangJie/happy-rusty.git"
  },
  "keywords": [
    "rust",
    "typescript",
    "Option",
    "Some",
    "None",
    "Result",
    "Ok",
    "Err",
    "Once",
    "Lazy",
    "Mutex",
    "RwLock",
    "Semaphore",
    "Channel",
    "ControlFlow",
    "FnOnce",
    "error-handling",
    "null-safety",
    "async",
    "concurrency"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "4.1.11",
    "publint": "^0.3.24",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite-plus": "^0.3.0"
  }
}
